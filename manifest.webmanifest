{
  "name": "Carnet auto",
  "short_name": "Carnet auto",
  "description": "Suivi technique et financier de mes voitures : pleins, entretien, pneus, remarques, échéances.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "fr",
  "background_color": "#F4F1EA",
  "theme_color": "#1B2326",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ajouter un document ou une saisie", "short_name": "Ajouter", "url": "./?ajouter=1", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Échéances", "short_name": "Échéances", "url": "./?vue=echeances", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Statistiques", "short_name": "Stats", "url": "./?vue=stats", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png", ".webp", ".heic"] }] }
  }
}
